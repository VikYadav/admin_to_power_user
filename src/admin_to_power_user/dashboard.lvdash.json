{
 "datasets": [
  {
   "name": "items",
   "displayName": "What breaks and how to fix it",
   "queryLines": [
    "WITH latest AS (SELECT workspace_id, max_by(run_id, run_ts) AS run_id FROM `__CATALOG__`.`__SCHEMA__`.runs GROUP BY workspace_id)\n",
    "SELECT d.workspace_id,\n",
    "  CASE WHEN d.covered_by IS NOT NULL THEN 'Fixed by your permission set'\n",
    "       WHEN d.breaks AND d.severity IN ('BLOCKER', 'HIGH') THEN 'Breaks - high impact'\n",
    "       WHEN d.breaks THEN 'Breaks - lower impact' ELSE 'Keeps working - review' END AS status,\n",
    "  d.severity,\n",
    "  CASE d.severity WHEN 'BLOCKER' THEN 1 WHEN 'HIGH' THEN 2 WHEN 'MEDIUM' THEN 3 WHEN 'LOW' THEN 4 ELSE 5 END AS severity_order,\n",
    "  regexp_replace(d.principal, '^(user|sp|group):', '') AS person,\n",
    "  CASE d.kind WHEN 'RUN_AS_DEPENDENCY' THEN 'Job or pipeline running as this person'\n",
    "    WHEN 'DIRECT_USE' THEN 'Access this person used' WHEN 'ENTITLEMENT' THEN 'Workspace entitlement'\n",
    "    WHEN 'ADMIN_ONLY_ACTION' THEN 'Admin-only task' WHEN 'TOKEN' THEN 'Personal access token'\n",
    "    WHEN 'UC_PRIVILEGE' THEN 'Unity Catalog privilege' WHEN 'OWNERSHIP_RISK' THEN 'Owned by a person'\n",
    "    WHEN 'NO_ADMIN_LEFT' THEN 'No admin left' ELSE d.kind END AS what_breaks,\n",
    "  concat(d.object_type, ': ', coalesce(d.object_name, d.object_id)) AS object,\n",
    "  coalesce(concat(d.artifact_type, ': ', d.artifact_name), '') AS used_by,\n",
    "  d.via AS why,\n",
    "  CASE r.bucket WHEN 'POWER_USERS_GRANT' THEN 'Grant to power_users' WHEN 'MOVE_TO_SP' THEN 'Move to a service principal'\n",
    "    WHEN 'PROCESS_CHANGE' THEN 'Central team process' WHEN 'COVERED' THEN 'Nothing to do' ELSE r.bucket END AS fix_type,\n",
    "  r.primary_action AS fix, r.alternative_action AS alternative, d.usage_count AS times_used, d.last_used,\n",
    "  CASE WHEN d.covered_by IS NULL AND d.breaks THEN 1 ELSE 0 END AS n_breaks,\n",
    "  CASE WHEN d.covered_by IS NULL AND d.breaks AND d.severity IN ('BLOCKER', 'HIGH') THEN 1 ELSE 0 END AS n_high,\n",
    "  CASE WHEN d.covered_by IS NULL AND d.breaks AND NOT d.severity IN ('BLOCKER', 'HIGH') THEN 1 ELSE 0 END AS n_lower,\n",
    "  CASE WHEN d.covered_by IS NOT NULL THEN 1 ELSE 0 END AS n_fixed,\n",
    "  CASE WHEN d.covered_by IS NULL AND NOT d.breaks THEN 1 ELSE 0 END AS n_review\n",
    "FROM `__CATALOG__`.`__SCHEMA__`.deltas d JOIN latest l ON d.workspace_id = l.workspace_id AND d.run_id = l.run_id\n",
    "JOIN `__CATALOG__`.`__SCHEMA__`.recommendations r ON r.delta_id = d.delta_id AND r.run_id = d.run_id AND r.workspace_id = d.workspace_id\n",
    "ORDER BY severity_order, d.usage_count DESC\n"
   ]
  },
  {
   "name": "run",
   "displayName": "About this run",
   "queryLines": [
    "WITH latest AS (SELECT workspace_id, max_by(run_id, run_ts) AS run_id FROM `__CATALOG__`.`__SCHEMA__`.runs GROUP BY workspace_id)\n",
    "SELECT t.workspace_id, t.workspace_host, t.run_ts, s.status, t.retained_admins AS stays_admin,\n",
    "  s.admins_in_scope AS admins_moving, s.humans_in_scope AS humans_moving, t.warnings\n",
    "FROM `__CATALOG__`.`__SCHEMA__`.runs t JOIN latest l ON t.workspace_id = l.workspace_id AND t.run_id = l.run_id\n",
    "JOIN `__CATALOG__`.`__SCHEMA__`.readiness_summary s ON s.workspace_id = t.workspace_id AND s.run_id = t.run_id\n"
   ]
  }
 ],
